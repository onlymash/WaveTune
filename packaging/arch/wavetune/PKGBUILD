# Maintainer: onlymash <fiepi.dev@gmail.com>
pkgname=wavetune
pkgver=0.1.0
pkgrel=1
pkgdesc="Wireless headset control center for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/onlymash/WaveTune"
license=('GPL-3.0-only')
depends=(
    'gtk4'
    'libadwaita'
    'bluez'
    'bluez-libs'
    'dbus'
    'libwebp'
)
makedepends=('cargo')
# LTO and symbol stripping are configured in Cargo.toml's release profile.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run `updpkgsums` after tagging a release to pin the real checksum.
sha256sums=('SKIP')

_srcname="WaveTune-$pkgver"

prepare() {
    cd "$_srcname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_srcname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-features
}

check() {
    cd "$_srcname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --all-features
}

package() {
    cd "$_srcname"
    sh packaging/install.sh "$pkgdir" target/release/wavetune
}
